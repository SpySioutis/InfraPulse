# InfraPulse environment configuration.
# Copy to `.env` and adjust values:  cp .env.example .env
# Never commit a real `.env` file.

# PostgreSQL
POSTGRES_USER=infrapulse
POSTGRES_PASSWORD=infrapulse
POSTGRES_DB=infrapulse

# Backend (FastAPI). Inside Docker Compose the host must be `db`.
DATABASE_URL=postgresql+psycopg://infrapulse:infrapulse@db:5432/infrapulse
BACKEND_PORT=8003

# --- Bootstrap admin (REQUIRED on first boot) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login

# --- Auth tokens ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=720

# --- Monitoring behavior ---
METRIC_RETENTION_DAYS=30
HEARTBEAT_GRACE_SECONDS=180
AGENT_INTERVAL_SECONDS=60

# --- Frontend ---
FRONTEND_PORT=8092
VITE_API_BASE_URL=
