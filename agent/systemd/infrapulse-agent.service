[Unit]
Description=InfraPulse monitoring agent
Documentation=https://github.com/SpySioutis/InfraPulse
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=infrapulse
Group=infrapulse
# Adjust the paths below to your installation (see MANUAL.md).
Environment=AGENT_CONFIG=/etc/infrapulse/agent.json
ExecStart=/opt/infrapulse-agent/.venv/bin/python -m infrapulse_agent
Restart=on-failure
RestartSec=15
# The agent only needs loopback + outbound HTTPS to the central server.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/infrapulse

[Install]
WantedBy=multi-user.target
